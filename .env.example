DB_URL=
PORT=

# JWT Configuration
JWT_ACCESS_KEY=
JWT_REFRESH_SECRET=
# Access token nên ngắn (15m–1h). FE dùng refresh token để gia hạn.
JWT_ACCESS_EXPIRES=1h
# Refresh token — không nên 365d trên production
JWT_REFRESH_EXPIRES=30d

# Facebook App Configuration
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Base URLs
BASE_URL=
# Origin FE chính (OAuth redirect / email / AI url). Nhiều origin phân cách `,` — phần tử đầu = primary.
# VD: https://phuongtayland.space,http://localhost:5173
CLIENT_URL=https://phuongtayland.space,http://localhost:5173
# Tùy chọn: thêm origin CORS khác (cũng phân cách bằng dấu phẩy)
# CLIENT_URLS=

# URL catalog cho AI pipeline (mặc định BASE_URL hoặc http://localhost:8000)
# CRM_CATALOG_API_URL=http://localhost:8000/api/crm-knowledge-catalog
# CRM_CATALOG_CACHE_MS=30000

# Session Secret — BẮT BUỘC mạnh trên production (không dùng default)
SESSION_SECRET=

# Giới hạn body JSON (chống payload lớn)
# JSON_BODY_LIMIT=1mb

# Swagger /api-docs — mặc định TẮT khi NODE_ENV=production; bật staging: ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false

# Auth rate limits (chống brute-force / spam)
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_REGISTER_RATE_LIMIT_MAX=5
# AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
# AUTH_OAUTH_RATE_LIMIT_MAX=20
# TRUST_PROXY_HOPS=1

# Rate limits bổ sung (Phase 3)
# GLOBAL_RATE_LIMIT_MAX=600
# AI_RATE_LIMIT_MAX=20
# UPLOAD_RATE_LIMIT_MAX=30
# CONTACT_RATE_LIMIT_MAX=10
# AUTH_LOGIN_RATE_LIMIT_MAX=20
# Render + Cloudflare: thử TRUST_PROXY_HOPS=2 nếu mọi user chung 1 IP rate-limit
# TRUST_PROXY_HOPS=1

# Email — gửi link quên mật khẩu (Gmail: dùng App Password, không dùng mật khẩu đăng nhập thường)
EMAIL_NAME=
EMAIL_PASSWORD=
# Tùy chọn branding email
# EMAIL_BRAND_NAME=Bất Động Sản DP
# EMAIL_BRAND_TAGLINE=Nền tảng bất động sản uy tín

# Cloudinary — API key phải có quyền Upload/Create (role Media Library User chỉ xem → 403)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_ENABLED=true
# CACHE_TTL_PROPERTY_LIST=45
# CACHE_TTL_PROPERTY_SLUG=180
# CACHE_TTL_ROLES=3600

# Phase 4 — Auth cookies (access httpOnly; dual với Authorization header)
# AUTH_COOKIE_SAMESITE=none
# AUTH_ACCESS_COOKIE=true

# Phase 4 — Rate-limit Redis store (cùng REDIS_*; tắt: RATE_LIMIT_REDIS=false)
# RATE_LIMIT_REDIS_PREFIX=rl:

# Phase 4 — OpenRouter timeout / circuit breaker
# OPENROUTER_TIMEOUT_MS=25000
# OPENROUTER_CB_THRESHOLD=5
# OPENROUTER_CB_COOLDOWN_MS=60000

# WEBRTC — STUN mặc định Google; TURN bắt buộc production NAT
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# WEBRTC_TURN_URLS=turn:turn.example.com:3478
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=


# QUEUE_ENABLED=true
# QUEUE_CONCURRENCY=5
# HTTP_CACHE_PROPERTY_LIST=30
# HTTP_CACHE_PROPERTY_DETAIL=60
# HTTP_CACHE_PROPERTY_RELATED=60

# Mongo connection pool
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=2

# OpenRouter — một API key cho mọi model (dùng @openrouter/sdk)
OPEN_ROUTER_KEY=
# Hoặc: OPENROUTER_API_KEY=

# Model chat :free — phân cách bằng dấu phẩy; bỏ trống = dùng chuỗi free mặc định
AI_CHAT_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-20b:free,openai/gpt-oss-120b:free

# Model embedding (có thể tốn credit OpenRouter)
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Vector Search (MongoDB Atlas)
VECTOR_SEARCH_INDEX=crm_knowledge_vector_index
VECTOR_SIMILARITY_THRESHOLD=0.6
VECTOR_TEXT_SEARCH_THRESHOLD=0.3

# Tùy chọn: Google AI Studio trực tiếp (không bắt buộc nếu đã có OPEN_ROUTER_KEY)
# GEMINI_API_KEY=
